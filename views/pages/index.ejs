<% layout("layouts/boilerplate.ejs") %>

<section class="container">

    <div class="page-header">
        <h1>All Campgrounds</h1>

        <a href="/campground/new" class="btn">
            Add New Campground
        </a>
    </div>

    <ul class="campground-list">

        <% campgrounds.forEach((camp) => { %>

            <li class="campground-card">

                <img
                    src="<%= camp.image %>"
                    alt="<%= camp.title %>"
                    class="campground-image"
                >

                <div class="campground-content">

                    <h2>
                        <a href="/campground/<%= camp.id %>">
                            <%= camp.title %>
                        </a>
                    </h2>

                    <p class="location">
                        📍 <%= camp.location %>
                    </p>

                    <p class="description">
                        <%= camp.description %>
                    </p>

                    <div class="campground-bottom">

                        <strong class="price">
                            ₹<%= camp.price %> / night
                        </strong>

                        <a
                            href="/campground/<%= camp.id %>"
                            class="view-btn"
                        >
                            View
                        </a>

                    </div>

                </div>

            </li>

        <% }); %>

    </ul>

</section>