<% layout("layouts/boilerplate.ejs") %>

<div class="auth-page">
    <h1>Welcome Back</h1>

    <% if (error) { %>
    <div class="auth-error" role="alert">
        <svg class="auth-error-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
        </svg>
        <div class="auth-error-content">
            <p class="auth-error-message"><%= error %></p>
            <button type="button" class="auth-error-retry" onclick="document.getElementById('email').focus()">
                Try Again
            </button>
        </div>
    </div>
    <% } %>

    <form action="/login" method="POST" class="auth-form">
        <div>
            <label for="email">Email Address</label>
            <input
                type="email"
                id="email"
                name="email"
                placeholder="you@example.com"
                required
                autocomplete="email"
                value="<%= email || '' %>"
            >
        </div>

        <div>
            <label for="password">Password</label>
            <input
                type="password"
                id="password"
                name="password"
                placeholder="Enter your password"
                required
                autocomplete="current-password"
            >
        </div>

        <button type="submit">Sign In</button>
    </form>

    <p>
        Don't have an account?
        <a href="/register">Create one</a>
    </p>
</div>

<style>
.auth-error {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--color-error-light);
    border: 1.5px solid var(--color-error);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-xl);
    animation: auth-error-shake 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97);
}

@media (prefers-reduced-motion: reduce) {
    .auth-error {
        animation: auth-error-fade 0.3s ease-in;
    }
}

@keyframes auth-error-shake {
    0%, 100% {
        transform: translateX(0);
    }
    10%, 30%, 50%, 70%, 90% {
        transform: translateX(-4px);
    }
    20%, 40%, 60%, 80% {
        transform: translateX(4px);
    }
}

@keyframes auth-error-fade {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

.auth-error-icon {
    width: 24px;
    height: 24px;
    color: var(--color-error);
    flex-shrink: 0;
    margin-top: 2px;
}

.auth-error-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
}

.auth-error-message {
    color: var(--color-error);
    font-weight: 500;
    font-size: 0.9375rem;
    margin: 0;
    line-height: 1.5;
}

.auth-error-retry {
    align-self: flex-start;
    padding: 0.5rem 1rem;
    background: var(--color-white);
    color: var(--color-error);
    border: 1.5px solid var(--color-error);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.auth-error-retry:hover {
    background: var(--color-error);
    color: var(--color-white);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
}
</style>
