<% layout("layouts/boilerplate.ejs") %>

<section class="container">

    <div class="show-card">

        <img
            src="<%= campgrounds.image %>"
            alt="<%= campgrounds.title %>"
            class="show-image"
        >

        <div class="show-content">

            <h1>
                <%= campgrounds.title %>
            </h1>

            <p class="location">
                📍 <%= campgrounds.location %>
            </p>

            <p class="show-description">
                <strong>Description:</strong>
                <%= campgrounds.description %>
            </p>

            <p class="show-price">
                ₹<%= campgrounds.price %> / night
            </p>

        </div>

    </div>

    <div class="actions">

        <a href="/campground" class="btn">
            All Campgrounds
        </a>

        <a href="/campground/new" class="btn">
            Add New
        </a>

        <a
            href="/campground/<%= campgrounds.id %>/edit"
            class="btn"
        >
            Edit
        </a>

        <form
            action="/campground/<%= campgrounds.id %>/delete"
            method="get"
            style="display: inline;"
        >
            <button type="submit" class="delete-btn">
                Delete
            </button>
        </form>

    </div>

</section>