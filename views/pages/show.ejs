<% layout("layouts/boilerplate.ejs") %>

<section class="container">

    <div class="campground-details">

        <h1><%= campgrounds.title %></h1>

        <p>
            <strong>Description:</strong>
            <%= campgrounds.description %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= campgrounds.location %>
        </p>

        <p>
            <strong>Price:</strong>
            ₹<%= campgrounds.price %>
        </p>

    </div>

    <div class="actions">

        <a href="/campground" class="btn">
            All Campgrounds
        </a>

        <a href="/campground/new" class="btn">
            Add New
        </a>

        <a href="/campground/<%= campgrounds.id %>/edit" class="btn">
            Edit
        </a>

        <form
            action="/campground/<%= campgrounds.id %>/delete"
            method="get"
            style="display: inline;"
        >
            <button type="submit" class="delete-btn">
                Delete
            </button>
        </form>

    </div>

</section>