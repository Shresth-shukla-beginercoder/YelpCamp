<% layout("layouts/boilerplate.ejs") %>

<section class="container">

    <h1>Update Campground</h1>

    <form action="/campground/<%= campground.id %>/edit" method="post" class="campground-form" enctype="multipart/form-data" novalidate>

        <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" placeholder="Enter title" value="<%= campground.title %>">
            <small class="msg"></small>
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="7" placeholder="Enter description"><%= campground.description %></textarea>
            <small class="msg"></small>
        </div>

        <div class="form-group">
            <label for="price">Price</label>
            <input type="number" id="price" name="price" placeholder="Enter price" value="<%= campground.price %>">
            <small class="msg"></small>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" placeholder="Enter location" value="<%= campground.location %>">
            <small class="msg"></small>
        </div>

        <div class="form-group">
            <p>Current Image</p>
            <img src="<%= campground.image %>" alt="<%= campground.title %>" width="250">
        </div>

        <div class="form-group">
            <label for="image">Upload new Image</label>
            <input type="file" id="image" name="image" accept="image/*" data-optional>
            <small class="msg"></small>
        </div>

        <button type="submit" class="btn">Update Campground</button>

    </form>

</section>

<script src="/js/validate.js"></script>