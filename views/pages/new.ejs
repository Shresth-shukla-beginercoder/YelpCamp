<% layout("layouts/boilerplate.ejs") %>

<section class="container">

    <div style="max-width: 700px; margin: 0 auto;">
        <div style="margin-bottom: 2rem;">
            <a href="/campground" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 0.5rem;">
                ← Back to Campgrounds
            </a>
        </div>

        <div style="margin-bottom: 2rem;">
            <h1 style="font-size: 2.25rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: 0.5rem;">
                Add New Campground
            </h1>
            <p style="color: var(--color-text-secondary); font-size: 1.0625rem;">
                Share your favorite camping spot with the community
            </p>
        </div>

        <form action="/campground" method="POST" class="campground-form" enctype="multipart/form-data" novalidate>

            <% if (typeof error !== "undefined" && error) { %>
                <div class="review-error" style="margin: 0 0 var(--space-lg);">⚠️ <%= error %></div>
            <% } %>

            <div class="form-group">
                <label for="title">Campground Name</label>
                <input
                    type="text"
                    id="title"
                    name="title"
                    placeholder="e.g., Sunset Valley Campground"
                    value="<%= typeof values !== 'undefined' && values ? values.title : '' %>"
                    required
                >
                <small class="msg"></small>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input
                    type="text"
                    id="location"
                    name="location"
                    placeholder="e.g., Yosemite National Park, California"
                    value="<%= typeof values !== 'undefined' && values ? values.location : '' %>"
                    required
                >
                <small class="msg"></small>
            </div>

            <div class="form-group">
                <label for="price">Price per Night (₹)</label>
                <input
                    type="number"
                    id="price"
                    name="price"
                    placeholder="500"
                    min="0"
                    step="1"
                    value="<%= typeof values !== 'undefined' && values ? values.price : '' %>"
                    required
                >
                <small class="msg"></small>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea
                    id="description"
                    name="description"
                    rows="6"
                    placeholder="Describe what makes this campground special..."
                    required
                ><%= typeof values !== 'undefined' && values ? values.description : '' %></textarea>
                <small class="msg"></small>
            </div>

            <div class="form-group">
                <label for="image">Campground Image</label>
                <input
                    type="file"
                    id="image"
                    name="image"
                    accept="image/*"
                    required
                >
                <small class="msg"></small>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 1rem; font-size: 1rem;">
                Add Campground
            </button>

        </form>
    </div>

</section>

<script src="/js/validate.js"></script>
