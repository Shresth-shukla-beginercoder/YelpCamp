
<% layout("layouts/boilerplate.ejs") %>

<div class="container mt-4">
    <h1>Admin Dashboard</h1>
    <p>Welcome, <%= user.username %>!</p>

    <hr>
 
    <h3>Website Statistics</h3>

    <div class="row mt-3">
        <div class="col-md-3 mb-3">
            <div class="card p-3">
                <h5>Total Users</h5>
                <h2><%= stats.totalUsers %></h2>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card p-3">
                <h5>Total Campgrounds</h5>
                <h2><%= stats.totalCampgrounds %></h2>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card p-3">
                <h5>Total Reviews</h5>
                <h2><%= stats.totalReviews %></h2>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card p-3">
                <h5>Total Admins</h5>
                <h2><%= stats.totalAdmins %></h2>
            </div>
        </div>
    </div>
</div>
