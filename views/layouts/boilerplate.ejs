<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YelpCamp - Find Your Next Great Escape</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/chatWidget.css">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <!-- MapTiler SDK -->
    <script src="https://cdn.maptiler.com/maptiler-sdk-js/v3.6.1/maptiler-sdk.umd.min.js"></script>
    <link href="https://cdn.maptiler.com/maptiler-sdk-js/v3.6.1/maptiler-sdk.css" rel="stylesheet">
</head>
<body>

<nav class="navbar">
    <div class="navbar-container">
        <a href="/" class="navbar-brand">YelpCamp</a>

        <ul class="navbar-menu" id="navbarMenu">
            <li><a href="/" class="navbar-link">Home</a></li>
            <li><a href="/campground" class="navbar-link">Explore</a></li>

            <% if (typeof user !== "undefined" && user) { %>
                <li><a href="/campground/new" class="navbar-link">Add Campground</a></li>

                <% if (user.is_admin === true) { %>
                    <li><a href="/admin" class="navbar-link">Admin</a></li>
                <% } %>

                <li>
                    <form action="/logout" method="POST" style="display: inline;">
                        <button type="submit" class="navbar-btn navbar-btn-secondary">Logout</button>
                    </form>
                </li>
            <% } else { %>
                <li><a href="/login" class="navbar-link">Login</a></li>
                <li><a href="/register"><button class="navbar-btn navbar-btn-primary">Sign Up</button></a></li>
            <% } %>
        </ul>

        <button class="navbar-toggle" id="navbarToggle">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</nav>

<!-- Custom Confirmation Modal -->
<div class="modal-overlay" id="confirmModal">
    <div class="modal-container">
        <div class="modal-header">
            <div class="modal-icon">⚠️</div>
            <h3 class="modal-title">Confirm Action</h3>
        </div>
        <div class="modal-body">
            Are you sure you want to delete this? This action cannot be undone.
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" id="modalCancel">Cancel</button>
            <button class="btn btn-danger" id="modalConfirm">Delete</button>
        </div>
    </div>
</div>

<main>
    <%- body %>
</main>

<footer>
    <div class="footer-content">
        <div class="footer-brand">🏕️ YelpCamp</div>
        <div class="footer-links">
            <a href="/">Home</a>
            <a href="/campground">Campgrounds</a>
            <a href="/campground/new">Add New</a>
        </div>
        <div style="color: rgba(255, 255, 255, 0.7); font-size: 0.875rem;">
            &copy; 2026 YelpCamp. Find Your Adventure.
        </div>
    </div>
</footer>

<script>
    // Mobile menu toggle
    const navbarToggle = document.getElementById('navbarToggle');
    const navbarMenu = document.getElementById('navbarMenu');

    if (navbarToggle && navbarMenu) {
        navbarToggle.addEventListener('click', () => {
            navbarMenu.classList.toggle('active');
        });
    }

    // Global confirmation for destructive actions
    const confirmModal = document.getElementById('confirmModal');
    const modalCancel = document.getElementById('modalCancel');
    const modalConfirm = document.getElementById('modalConfirm');
    let formToSubmit = null;

    document.addEventListener('submit', (e) => {
        const target = e.target;
        if (target.tagName === 'FORM' && (target.action.includes('delete') || target.querySelector('.delete-btn') || target.querySelector('.review-delete-btn'))) {
            if (!formToSubmit) {
                e.preventDefault();
                formToSubmit = target;
                confirmModal.classList.add('active');
            }
        }
    });

    modalCancel.addEventListener('click', () => {
        confirmModal.classList.remove('active');
        formToSubmit = null;
    });

    modalConfirm.addEventListener('click', () => {
        if (formToSubmit) {
            formToSubmit.submit();
        }
    });

    // Close modal on background click
    confirmModal.addEventListener('click', (e) => {
        if (e.target === confirmModal) {
            confirmModal.classList.remove('active');
            formToSubmit = null;
        }
    });
</script>

<script>
    // Non-secret: only the public FastAPI chat service URL is exposed to the
    // browser. The Gemini key and the Express service token stay server-side.
    window.YELPCAMP_CHAT_API = <%- JSON.stringify(typeof chatApiUrl !== "undefined" ? chatApiUrl : "http://localhost:8000") %>;
</script>

<!-- Floating chat widget -->
<button id="chatLauncher" type="button" aria-label="Open chat assistant" title="Chat with us">
    <img src="/image/chatAssistantLogo.svg" alt="YelpCamp chat assistant logo: a golden tent between pine trees, mountains and a small sun" class="chat-logo" width="44" height="44" decoding="async">
</button>

<div id="chatPanel" role="dialog" aria-label="Chat assistant" aria-hidden="true">
    <div class="chat-header">
        <span class="chat-title"><img src="/image/chatAssistantLogo.svg" alt="YelpCamp chat assistant logo" class="chat-logo chat-logo--header" width="28" height="28" decoding="async"> Camp Assistant</span>
        <button class="chat-close" id="chatClose" type="button" aria-label="Close chat">✕</button>
    </div>
    <div class="chat-messages" id="chatMessages" aria-live="polite">
        <div class="chat-msg assistant">Hi! Ask me about campgrounds, prices, or reviews — e.g. “Find a camp under $40 in Arizona.”</div>
    </div>
    <div class="chat-composer">
        <textarea id="chatInput" rows="1" placeholder="Ask about campgrounds…" aria-label="Chat message"></textarea>
        <button id="chatSend" type="button" aria-label="Send message">Send</button>
    </div>
</div>

<script src="/js/chatWidget.js" defer></script>

<script src="/js/validate.js" defer></script>
</body>
</html>
